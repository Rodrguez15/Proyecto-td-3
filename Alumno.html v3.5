<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Alumnos - MMA Systems</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <header class="navbar">
        <div class="logo">Escuela Combate VILAMIR</div>
        <nav>
            <a href="index.html">Inicio</a>
            <a href="alumnos.html">Alumnos</a>
            <a href="tutores.html">Tutores</a>
            <a href="clases.html">Clases</a>
            <a href="grupos.html">Grupos</a>
            <a href="seminarios.html">Seminarios</a>
            <a href="about.html">About Us</a>
        </nav>
    </header>

    <main class="about-container">
        <h1>Gestión de Alumnos</h1>
        
        <!-- Formulario para agregar alumnos -->
        <section class="project-info" style="margin-bottom: 30px;">
            <h2>Registrar Nuevo Alumno</h2>
            <div style="display: grid; gap: 10px; grid-template-columns: 1fr 1fr;">
                <input type="text" id="nombreAlumno" placeholder="Nombre">
                <input type="text" id="apellidoAlumno" placeholder="Apellido">
                <input type="email" id="emailAlumno" placeholder="Correo Electrónico" style="grid-column: span 2;">
                <button id="btnGuardarAlumno">Guardar Alumno</button>
            </div>
        </section>

        <!-- Tabla o lista de alumnos -->
        <section class="project-info">
            <h2>Listado de Alumnos</h2>
            <div id="listaAlumnos">
                <p>Cargando alumnos...</p>
            </div>
        </section>
    </main>

    <footer>© 2026 MMA Systems</footer>
    <script src="js/alumnos.js"></script>
</body>
</html>
