// Escapa caracteres especiales para evitar insertar HTML inseguro.
const esc = (value) => String(value ?? '').replace(
    /[&<>"']/g,
    (match) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
    }[match])
);

// Realiza una consulta GET a la API administrativa.
async function get(entity) {
    const response = await fetch(
        `${API}?entity=${encodeURIComponent(entity)}`
    );

    return response.json();
}

// Inicializa las pestañas, las estadísticas y el primer módulo.
async function init() {
    const tabs = document.getElementById('tabs');

    tabs.innerHTML = Object.entries(modules)
        .map(
            ([key, module]) =>
                `<button onclick="show('${key}')">${module.title}</button>`
        )
        .join('');

    await stats();
    await show('alumnos');
}

// Consulta y muestra los contadores del dashboard.
async function stats() {
    const data = await get('dashboard');

    if (data.status !== 'success') {
        return;
    }

    const labels = {
        alumnos: 'Alumnos',
        profesores: 'Profesores',
        responsables: 'Responsables',
        disciplinas: 'Disciplinas',
        grupos: 'Grupos',
        horarios: 'Horarios',
        pagos: 'Pagos',
        notificaciones: 'Notificaciones',
        seminarios: 'Seminarios',
        promociones: 'Promociones',
        usuarios: 'Usuarios'
    };
