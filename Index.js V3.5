document.addEventListener("DOMContentLoaded", function () {
    const btnCerrar = document.getElementById("cerrarSesion");
    if (btnCerrar) {
        btnCerrar.addEventListener("click", function () {
            window.location.href = "logout.php";
        });
    }
});
