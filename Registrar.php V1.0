<?php
// ============================================================
// REGISTRO DE USUARIOS - MMA SYSTEMS
// Crea una cuenta (rol Alumno) con contraseña hasheada y sus
// datos personales en ALUMNO. Responde JSON hacia registrar.js.
// ============================================================
session_start();

// Importar la conexión a la base de datos
require_once 'config/conexion.php';

$response = ['status' => 'error', 'message' => ''];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    header('Content-Type: application/json; charset=utf-8');

    // Recibir y limpiar los datos del formulario
    $nombre = isset($_POST['nombre']) ? trim($_POST['nombre']) : '';
    $apellido = isset($_POST['apellido']) ? trim($_POST['apellido']) : '';
    $email = isset($_POST['email']) ? trim($_POST['email']) : '';
    $password = isset($_POST['password']) ? $_POST['password'] : '';
    $confirmPassword = isset($_POST['confirmPassword']) ? $_POST['confirmPassword'] : '';

    // --- Validaciones server-side ---
    if ($nombre === '' || $apellido === '' || $email === '' || $password === '' || $confirmPassword === '') {
        $response['message'] = "Debe completar todos los campos.";
        echo json_encode($response);
        exit;
    }
    if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $response['message'] = "Correo electrónico no válido.";
        echo json_encode($response);
        exit;
    }
    if (mb_strlen($password) < 8) {
        $response['message'] = "La contraseña debe tener al menos 8 caracteres.";
        echo json_encode($response);
        exit;
    }
    if ($password !== $confirmPassword) {
        $response['message'] = "Las contraseñas no coinciden.";
        echo json_encode($response);
        exit;
    }

    try {
        // Evitar correos duplicados
        $stmt = $conexion->prepare("SELECT ID_Usuario FROM USUARIO WHERE Email = :email LIMIT 1");
        $stmt->bindParam(':email', $email, PDO::PARAM_STR);
        $stmt->execute();
        if ($stmt->fetch()) {
            $response['message'] = "Ese correo ya está registrado en el sistema.";
            echo json_encode($response);
            exit;
        }

        // Hash seguro de la contraseña
        $hash = password_hash($password, PASSWORD_DEFAULT);

        // Insertar cuenta y datos del alumno en una transacción
        $conexion->beginTransaction();

        $stmt = $conexion->prepare(
            "INSERT INTO USUARIO (Email, Contraseña, Rol) VALUES (:email, :hash, 'Alumno')"
        );
        $stmt->bindParam(':email', $email, PDO::PARAM_STR);
        $stmt->bindParam(':hash', $hash, PDO::PARAM_STR);
        $stmt->execute();

        $idUsuario = (int)$conexion->lastInsertId();

        $stmt = $conexion->prepare(
            "INSERT INTO ALUMNO (ID_Usuario, Nombre, Apellido) VALUES (:id, :nombre, :apellido)"
        );
        $stmt->bindParam(':id', $idUsuario, PDO::PARAM_INT);
        $stmt->bindParam(':nombre', $nombre, PDO::PARAM_STR);
        $stmt->bindParam(':apellido', $apellido, PDO::PARAM_STR);
        $stmt->execute();

        $conexion->commit();

        $response['status'] = 'success';
        $response['message'] = "Cuenta creada correctamente. Ya puedes iniciar sesión.";

    } catch (PDOException $e) {
        if ($conexion->inTransaction()) {
            $conexion->rollBack();
        }
        error_log("Error en registrar.php: " . $e->getMessage());
        $response['message'] = "Hubo un problema en el servidor. Intente más tarde.";
    }

    echo json_encode($response);
    exit;
}
