<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Tutores - MMA Systems</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <header class="navbar">
        <div class="logo">Escuela Combate VILAMIR</div>
        <nav>
            <a href="index.php">Inicio</a>
            <a href="alumnos.html">Alumnos</a>
            <a href="tutores.html">Tutores</a>
            <a href="clases.html">Clases</a>
            <a href="grupos.html">Grupos</a>
            <a href="seminarios.html">Seminarios</a>
            <a href="about.html">About Us</a>
        </nav>
    </header>

    <main class="about-container">
        <h1>Gestión de Tutores</h1>
        
        <!-- Formulario para agregar tutores -->
        <section class="project-info" style="margin-bottom: 30px;">
            <h2>Registrar Nuevo Tutor</h2>
            <div style="display: grid; gap: 10px; grid-template-columns: 1fr 1fr;">
                <input type="text" id="nombreTutor" placeholder="Nombre">
                <input type="text" id="apellidoTutor" placeholder="Apellido">
                <input type="text" id="especialidadTutor" placeholder="Especialidad (ej. Jiu-Jitsu, Muay Thai)" style="grid-column: span 2;">
                <input type="email" id="emailTutor" placeholder="Correo Electrónico" style="grid-column: span 2;">
                <button id="btnGuardarTutor">Guardar Tutor</button>
            </div>
        </section>

        <!-- Listado de tutores -->
        <section class="project-info">
            <h2>Cuerpo Docente</h2>
            <div id="listaTutores">
                <p>Cargando tutores...</p>
            </div>
        </section>
    </main>

    <footer>© 2026 MMA Systems</footer>

    <script src="js/tutores.js"></script>
</body>
</html>
